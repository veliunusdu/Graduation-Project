@model HomeworkPlatform.Web.Models.TeacherSearchViewModel
@{ ViewData["Title"] = "Search"; }
<div class="ep-teacher-heading"><div><span class="ep-eyebrow">YOUR WORKSPACE</span><h1>Search results</h1><p>@(Model.Query.Length == 0 ? "Enter a course name, assignment title or description above." : $"Results for “{Model.Query}” — up to 100 matches per group.")</p></div></div>
<div class="ep-card p-4 mb-4"><h2>Courses <span class="ep-muted">(@Model.Courses.Count)</span></h2>@if(Model.Courses.Count == 0){<p class="ep-muted">No matching courses.</p>}@foreach(var c in Model.Courses){<div class="py-3 border-bottom"><a asp-controller="Courses" asp-action="Details" asp-route-id="@c.Id" class="fw-bold">@c.Name</a><p class="ep-muted small mb-0">@c.Description</p></div>}</div>
<div class="ep-card p-4"><h2>Assignments <span class="ep-muted">(@Model.Assignments.Count)</span></h2>@if(Model.Assignments.Count == 0){<p class="ep-muted">No matching assignments.</p>}@foreach(var a in Model.Assignments){<div class="py-3 border-bottom"><a asp-controller="Assignments" asp-action="Details" asp-route-id="@a.Id" class="fw-bold">@a.Title</a><p class="ep-muted small mb-0">@a.Course.Name</p></div>}</div>
