@model IReadOnlyList<HomeworkPlatform.Web.Models.Domain.Submission>
@{ViewData["Title"]="Submitted assignments";}
<div class="ep-teacher-heading"><div><h1>Submitted assignments</h1><p>Your work, grades and teacher feedback.</p></div></div>@if(Model.Count==0){<div class="ep-card ep-empty"><h2>You have not submitted anything yet</h2><p>Open an assignment to submit your work.</p><a asp-controller="StudentWork" asp-action="Index" asp-route-status="Pending" class="btn btn-primary">View not submitted assignments</a></div>}<div class="d-grid gap-3">@foreach(var s in Model){<partial name="_StudentSubmissionCard" model="s" />}</div>
