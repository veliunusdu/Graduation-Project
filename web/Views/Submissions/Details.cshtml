@model HomeworkPlatform.Web.Models.Domain.Submission
@{ ViewData["Title"] = "My submission"; }
<h1>@Model.Assignment.Title — my submission</h1><pre class="border rounded p-3" style="white-space:pre-wrap">@Model.Content</pre>
<p><a asp-action="Edit" asp-route-id="@Model.Id">Edit</a> | <a asp-action="Delete" asp-route-id="@Model.Id">Delete</a> | <a asp-action="Index">My submissions</a></p>
