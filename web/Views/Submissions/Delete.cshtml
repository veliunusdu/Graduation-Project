@model HomeworkPlatform.Web.Models.Domain.Submission
@{ViewData["Title"]="Withdraw submission";}
<div class="ep-form-card"><h1 class="h4">Withdraw your submission?</h1><p class="ep-muted">@Model.Assignment.Title</p><p>Your submitted text, file and any teacher review will be removed. You can submit your work again while you have access to this assignment.</p><div asp-validation-summary="All" class="text-danger" role="alert"></div><form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="ep-action-row"><a asp-action="Details" asp-route-id="@Model.Id" class="btn ep-secondary-link">Keep submission</a><button type="submit" class="btn ep-danger-link">Withdraw submission</button></form></div>
