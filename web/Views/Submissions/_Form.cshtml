@model HomeworkPlatform.Web.Models.Work.SubmissionForm
@inject Microsoft.Extensions.Options.IOptions<HomeworkPlatform.Web.Services.Files.SubmissionFileOptions> FileOptions
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<div class="mb-3"><label asp-for="Content">Your work / note to teacher (optional)</label><textarea asp-for="Content" class="form-control" rows="7" placeholder="Write your answer or add a note for your teacher."></textarea><span asp-validation-for="Content" class="text-danger"></span></div>
<div class="ep-attachment-upload mb-3"><label asp-for="Upload">Submission file (optional)</label><input asp-for="Upload" type="file" class="form-control" accept="@string.Join(",",HomeworkPlatform.Web.Services.Files.SubmissionFileStore.AllowedExtensions)" aria-describedby="upload-help" /><p id="upload-help" class="ep-student-form-hint mt-2 mb-0">PDF, DOC, DOCX, ZIP or supported code/text files, up to @FileOptions.Value.MaxFileSizeMB MB. Use ZIP for multiple files. Code files must be UTF-8.</p><span asp-validation-for="Upload" class="text-danger"></span></div>
<p class="ep-student-form-hint">Provide text, a file, or both. Select the file again after a validation error.</p>
@if(Model.ExistingFileName!=null){<p class="small">Current file: <strong>@Model.ExistingFileName</strong>. Uploading a new file replaces it.</p><div class="form-check mb-3"><input asp-for="RemoveFile" class="form-check-input" /><label asp-for="RemoveFile" class="form-check-label">Remove current file</label></div><p class="ep-student-form-hint">Saving changes clears the previous grade and feedback so your teacher can review the updated work.</p>}
<button class="btn btn-primary" type="submit">Save submission</button>
