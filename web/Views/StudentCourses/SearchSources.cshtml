@model IReadOnlyList<HomeworkPlatform.Web.Controllers.StudentCoursesController.CourseSource>
@{ ViewData["Title"] = "Ders kaynakları"; }
<h1>Ders kaynakları</h1>
@if (Model.Count == 0)
{
    <p>Bu soru için uygun ders kaynağı bulunamadı.</p>
}
@foreach (var source in Model)
{
    <article class="mb-3">
        <h2 class="h5">@source.FileName · Sayfa @source.PageNumber</h2>
        <p>@source.Text</p>
    </article>
}
<a asp-action="Details" asp-route-id="@ViewData["CourseId"]">Derse dön</a>
