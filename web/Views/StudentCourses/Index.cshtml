@model IReadOnlyList<HomeworkPlatform.Web.Models.Domain.Course>
@{ ViewData["Title"] = "My enrolled courses"; }
<h1>My enrolled courses</h1>
@if (Model.Count == 0) { <p>No active enrolled courses. Ask your teacher to enroll you.</p> }
<ul>@foreach (var course in Model) { <li><a asp-action="Details" asp-route-id="@course.Id">@course.Name</a> — @course.EducationLevel / @course.GradeLevel</li> }</ul>
