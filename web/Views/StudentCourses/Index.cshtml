@model IReadOnlyList<HomeworkPlatform.Web.Models.StudentCourseCard>
@{ViewData["Title"]="My courses";}
<div class="ep-teacher-heading"><div><h1>My courses</h1><p>Courses you are enrolled in, ready for learning.</p></div></div>@if(Model.Count==0){<div class="ep-card ep-empty"><h2>No enrolled courses yet</h2><p>Your teacher can enroll you in a course.</p></div>}<div class="ep-course-card-grid">@foreach(var c in Model){<partial name="_StudentCourseCard" model="c" />}</div>
