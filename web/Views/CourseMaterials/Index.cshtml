@using HomeworkPlatform.Web.Models.Domain
@model IReadOnlyList<CourseMaterial>
@{ var course=(Course)ViewData["Course"]!;var teacher=(bool)ViewData["Teacher"]!;ViewData["Title"]="Ders materyalleri"; }
<h1>@course.Name — Ders materyalleri</h1>
@if(TempData["MaterialError"] is string error){<p role="alert" class="text-danger">@error</p>}
@if(teacher && course.IsActive){
<form asp-action="Upload" asp-route-courseId="@course.Id" method="post" enctype="multipart/form-data">
<label for="upload">PDF, DOCX, PPTX veya UTF-8 TXT (en fazla 20 MB)</label>
<input type="file" name="upload" id="upload" accept=".pdf,.docx,.pptx,.txt" required />
<button type="submit">Yükle ve işle</button>
<p>İşlem tamamlanana kadar bekleyin. Durumu başka bir sekmede bu sayfadan kontrol edebilirsiniz.</p>
</form>}
<table class="table"><thead><tr><th>Dosya</th><th>Durum</th><th>İşlemler</th></tr></thead><tbody>
@foreach(var m in Model){
<tr><td>@m.OriginalFileName</td><td>
@(m.Status switch{MaterialStatus.Uploaded=>"Yüklendi",MaterialStatus.Processing=>"İşleniyor",MaterialStatus.Ready=>"Hazır",_=>"Başarısız"})
@if(m.Status==MaterialStatus.Ready){<span> (@m.ChunkCount parça)</span>}
@if(teacher && m.ErrorMessage!=null){<p role="alert">@m.ErrorMessage</p>}
</td><td><a asp-action="Download" asp-route-id="@m.Id">İndir</a>
@if(teacher && course.IsActive && (m.Status==MaterialStatus.Failed || m.Status==MaterialStatus.Uploaded || m.Status==MaterialStatus.Processing && m.ProcessingStartedAt<DateTime.UtcNow.AddMinutes(-5))){
<form asp-action="Retry" asp-route-id="@m.Id" method="post"><button type="submit">Yeniden dene</button></form>}
</td></tr>}
</tbody></table>
<a asp-action="Index" asp-route-courseId="@course.Id">Durumu yenile</a>
