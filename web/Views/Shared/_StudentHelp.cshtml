@model int
<section class="ep-card p-4 ep-student-help"><h2>Need help?</h2><p class="small ep-muted">Search your course materials or ask the AI Tutor for an explanation.</p><form asp-controller="StudentCourses" asp-action="SearchSources" asp-route-id="@Model" method="post"><label for="question" class="small fw-bold mb-2">Your question</label><textarea class="form-control" id="question" name="question" rows="3" required maxlength="4000" placeholder="What would you like to understand?"></textarea><button type="submit" class="btn btn-light">Search sources</button><button type="submit" name="tutor" value="true" class="btn btn-ai">Ask AI Tutor</button></form><div class="mt-3 border-top pt-3"><button type="button" class="btn btn-light" disabled>Code Agent - Coming soon</button><p class="small ep-muted mt-2 mb-0">Dedicated code assistance is not available yet.</p></div></section>
