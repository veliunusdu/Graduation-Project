@model int
<section class="ep-card p-4 ep-student-help"><h2>Need help?</h2><p class="small ep-muted">Search your course materials or ask the AI Tutor for an explanation.</p><form asp-controller="StudentCourses" asp-action="SearchSources" asp-route-id="@Model" method="post">@if(ViewData["AssignmentId"] is int assignmentId){<input type="hidden" name="assignmentId" value="@assignmentId" />}<label for="question" class="small fw-bold mb-2">Your question</label><textarea class="form-control" id="question" name="question" rows="3" required maxlength="4000" placeholder="What would you like to understand?"></textarea><button type="submit" class="btn btn-light">Search sources</button><button type="submit" name="tutor" value="true" class="btn btn-ai">Ask AI Tutor</button></form><p class="small ep-muted mt-3 mb-0">The homework helper answers from the course materials uploaded for this class. On an assignment page, it also uses that assignment's title and requirements. It will not write the assignment for you.</p></section>
