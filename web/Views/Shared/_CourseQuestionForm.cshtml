@model int
<form asp-controller="StudentCourses" asp-action="SearchSources" asp-route-id="@Model" method="post" class="ep-rag-question-form"><label for="question" class="form-label">Your question</label><textarea class="form-control" id="question" name="question" required maxlength="4000" rows="3" placeholder="Ask a question about this course.">@ViewData["Question"]</textarea><div class="ep-action-row mt-3"><button type="submit" class="btn ep-secondary-link">Search sources</button><button type="submit" name="tutor" value="true" class="btn btn-ai">Ask AI Tutor</button></div></form>
