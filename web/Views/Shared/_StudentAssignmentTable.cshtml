@model IReadOnlyList<HomeworkPlatform.Web.Models.StudentAssignmentRow>
@if(Model.Count==0){<div class="ep-empty"><h2>No assignments to show</h2><p>Assignments for your enrolled courses will appear here.</p></div>}else{
<div class="ep-table-wrap"><table class="ep-teacher-table ep-student-table"><thead><tr><th>Assignment</th><th>Course</th><th>Due date</th><th>Status</th><th>Action</th></tr></thead><tbody>@foreach(var a in Model){<tr><td><a asp-controller="StudentWork" asp-action="Details" asp-route-id="@a.Assignment.Id">@a.Assignment.Title</a></td><td>@a.Assignment.Course.Name</td><td>@a.DueLabel</td><td><partial name="_StudentAssignmentBadge" model="a" /></td><td><a href="@Url.Content("~" + a.Target)">@(a.Submission==null ? "View assignment" : "View submission")</a></td></tr>}</tbody></table></div>}
