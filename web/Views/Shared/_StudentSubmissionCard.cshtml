@model HomeworkPlatform.Web.Models.Domain.Submission
<article class="ep-card p-4 ep-submission-card" id="s@(Model.Id)"><div class="ep-submission-top"><div><span class="small ep-muted">@Model.Assignment.Course.Name</span><h2 class="mt-2"><a asp-controller="Submissions" asp-action="Details" asp-route-id="@Model.Id" class="text-reset text-decoration-none">@Model.Assignment.Title</a></h2><p class="small ep-muted">Submitted @Model.CreatedAt.ToString("dd MMM yyyy, HH:mm",System.Globalization.CultureInfo.InvariantCulture) UTC</p><partial name="_SubmissionFile" model="Model" /></div>@if(Model.ReviewedAt.HasValue){<div class="ep-grade"><div><b>@Model.TeacherGrade</b><br /><small>/ 100</small></div></div>}else{<span class="ep-status">Awaiting review</span>}</div>@if(!string.IsNullOrWhiteSpace(Model.Content)){<pre class="ep-review-content mt-3">@Model.Content</pre>}@if(Model.ReviewedAt.HasValue){<div class="ep-feedback mt-3"><strong>Teacher feedback</strong><div>@(string.IsNullOrWhiteSpace(Model.TeacherFeedback)?"No comments.":Model.TeacherFeedback)</div></div>}<div class="ep-student-actions">@if(!Model.ReviewedAt.HasValue){<a asp-controller="Submissions" asp-action="Delete" asp-route-id="@Model.Id" class="btn ep-danger-link" data-withdraw-submission="@Model.Id">Withdraw submission</a><a asp-controller="Submissions" asp-action="Edit" asp-route-id="@Model.Id" class="btn ep-secondary-link">Edit submission</a>}<a asp-controller="Submissions" asp-action="Details" asp-route-id="@Model.Id" class="btn ep-secondary-link">View submission</a></div></article>
