@model HomeworkPlatform.Web.Models.Domain.Assignment
@{ ViewData["Title"] = Model.Title; }
<div class="ep-teacher-heading"><div><span class="ep-eyebrow">@Model.Course.Name</span><h1>@Model.Title</h1><p>Due date: @(Model.DueDate?.ToString("dd MMM yyyy",System.Globalization.CultureInfo.InvariantCulture) ?? "No due date")</p></div><div class="d-flex gap-2"><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-light">Edit assignment</a><a asp-action="Submissions" asp-route-id="@Model.Id" class="btn btn-primary">Student submissions</a></div></div>
<div class="ep-form-card ep-requirements-card"><h2 class="ep-requirements-heading">Requirements</h2><p class="ep-requirements-text">@Model.Description</p><partial name="_AssignmentAttachments" model="Model" /></div>
<div class="d-flex gap-3 mt-4"><a asp-action="Delete" asp-route-id="@Model.Id" class="text-danger btn ep-danger-link">Delete assignment</a></div>
