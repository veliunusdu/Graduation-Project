@model HomeworkPlatform.Web.Models.Domain.Assignment
@{ ViewData["Title"] = "Delete assignment"; }
<div class="ep-form-card"><h1 class="h4">Delete @Model.Title?</h1><p class="ep-muted">Assignments with student submissions cannot be deleted.</p>
@if(ViewData["DeleteWarning"] is string warning){<div class="alert alert-warning" role="alert">@warning</div>}
<form asp-action="Delete" asp-route-id="@Model.Id" method="post"><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-light">Cancel</a><button class="btn btn-danger" type="submit">Delete assignment</button></form></div>
