@model HomeworkPlatform.Web.Models.Domain.Submission
@{ ViewData["Title"] = "Submission review"; }
<h1>@Model.Assignment.Title</h1>
<p><strong>Öğrenci:</strong> @(ViewData["StudentEmail"] as string ?? "Bilinmeyen öğrenci")</p>
<p><strong>Teslim numarası:</strong> @Model.Id</p><pre class="border rounded p-3" style="white-space:pre-wrap">@Model.Content</pre>
<partial name="_SubmissionFile" model="Model" />
<div asp-validation-summary="All" class="text-danger"></div>
<form asp-action="Review" asp-route-id="@Model.Id" method="post">
<label for="Feedback">Teacher feedback</label><textarea id="Feedback" name="Feedback" maxlength="10000" required class="form-control">@Model.TeacherFeedback</textarea>
<label for="Grade">Grade (0-100)</label><input id="Grade" name="Grade" type="number" min="0" max="100" required value="@Model.TeacherGrade" class="form-control" />
<button class="btn btn-primary" type="submit">Save review</button>
</form>
<p><a asp-action="Submissions" asp-route-id="@Model.AssignmentId">Back to submissions</a></p>
