@model HomeworkPlatform.Web.Models.Work.AssignmentForm
@{ ViewData["Title"] = "Create assignment"; }
<div class="ep-teacher-heading"><div><span class="ep-eyebrow">YOUR WORKSPACE</span><h1>Create assignment</h1></div></div><p class="ep-muted">Course: @ViewData["CourseName"]</p><div class="ep-ai-banner"><div><h2>Create with AI Agent</h2><p>AI assignment drafting from course materials is coming soon. You can create assignments manually below.</p></div><button type="button" class="btn" disabled>Coming soon</button></div><div class="ep-form-card"><form asp-action="Create" asp-route-courseId="@ViewData["CourseId"]" method="post" enctype="multipart/form-data"><partial name="_Form" model="Model" /></form></div>
