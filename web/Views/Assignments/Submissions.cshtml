@model IReadOnlyList<HomeworkPlatform.Web.Models.Domain.Submission>
@{ ViewData["Title"] = "Student submissions";var emails=ViewData["StudentEmails"] as Dictionary<string,string> ?? new Dictionary<string,string>(); }
<div class="ep-teacher-heading"><div><span class="ep-eyebrow">ASSIGNMENT REVIEW</span><h1>Student submissions</h1><p>Submitted work for this assignment.</p></div><a asp-controller="Teacher" asp-action="Submissions" class="btn btn-light">All submissions</a></div>
<div class="ep-card">@if(Model.Count==0){<div class="ep-empty"><h2>No submissions yet</h2></div>}else{<div class="ep-table-wrap"><table class="ep-teacher-table"><thead><tr><th>Student</th><th>Submitted (UTC)</th><th>Grade</th><th>Actions</th></tr></thead><tbody>@foreach(var s in Model){<tr><td>@emails.GetValueOrDefault(s.StudentId,"Unknown student")</td><td>@s.CreatedAt.ToString("dd MMM yyyy, HH:mm",System.Globalization.CultureInfo.InvariantCulture)</td><td>@(s.TeacherGrade?.ToString() ?? "Not graded")</td><td><a asp-action="Submission" asp-route-id="@s.Id" class="btn btn-light btn-sm">Review submission</a></td></tr>}</tbody></table></div>}</div>
