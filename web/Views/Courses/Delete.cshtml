@model HomeworkPlatform.Web.Models.Domain.Course
@{ ViewData["Title"] = "Delete course"; }
<div class="ep-form-card"><h1 class="h4">Delete @Model.Name?</h1><p class="ep-muted">Courses containing assignments cannot be deleted. Student work is preserved.</p><form asp-action="Delete" asp-route-id="@Model.Id" method="post"><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-light">Cancel</a><button class="btn btn-danger" type="submit">Delete course</button></form></div>
