@model HomeworkPlatform.Web.Models.Work.CourseForm
<div asp-validation-summary="All" class="text-danger"></div>
<div class="mb-3"><label asp-for="Name"></label><input asp-for="Name" class="form-control" /></div>
<div class="mb-3"><label asp-for="Description"></label><textarea asp-for="Description" class="form-control" rows="4"></textarea></div>
<div class="mb-3"><label for="TeacherEducationLevel" class="form-label">Education level</label><input id="TeacherEducationLevel" class="form-control" value="@HomeworkPlatform.Web.Models.Domain.EducationRules.Label(Model.EducationLevel)" readonly /><small class="text-muted">Assigned to your teacher account.</small></div>
<div class="mb-3"><label asp-for="GradeLevel">@(Model.EducationLevel == HomeworkPlatform.Web.Models.Domain.EducationLevel.University ? "Year" : "Grade")</label><select asp-for="GradeLevel" class="form-select">@foreach (var grade in HomeworkPlatform.Web.Models.Domain.EducationRules.GradesFor(Model.EducationLevel)) { <option value="@grade">@grade</option> }</select><span asp-validation-for="GradeLevel" class="text-danger"></span></div>
<div class="form-check mb-3"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Active course</label></div>
@if (ViewData["AvailableStudents"] is IReadOnlyList<HomeworkPlatform.Web.Data.ApplicationUser> students)
{
    <fieldset class="mb-3"><legend class="h5">Enroll students</legend>
        <p class="text-muted small">Selected students will see this course automatically.</p>
        @foreach (var student in students)
        {
            <div class="form-check"><input type="checkbox" class="form-check-input" name="StudentIds" value="@student.Id" id="student-@student.Id" checked="@(Model.StudentIds.Contains(student.Id))" /><label class="form-check-label" for="student-@student.Id">@student.FirstName @student.LastName · @student.Email</label></div>
        }
        <span asp-validation-for="StudentIds" class="text-danger"></span>
    </fieldset>
}
<button type="submit" class="btn btn-primary">Save course</button>
